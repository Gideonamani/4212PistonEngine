{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cad-pipeline:part-spec:v1",
  "title": "Evidence-bearing engineering part/assembly specification",
  "type": "object",
  "required": [
    "schema_version",
    "model_id",
    "units",
    "input_mode",
    "scope",
    "sources",
    "parameters",
    "parts"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "model_id": {
      "type": "string",
      "minLength": 1
    },
    "units": {
      "const": "mm"
    },
    "input_mode": {
      "enum": [
        "image",
        "text",
        "mesh",
        "mixed"
      ]
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "coordinate_frame": {
      "type": "string"
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "locator": {
            "type": "string"
          }
        },
        "anyOf": [
          {
            "required": [
              "path"
            ]
          },
          {
            "required": [
              "url"
            ]
          },
          {
            "required": [
              "text"
            ]
          }
        ]
      }
    },
    "parameters": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/parameter"
      }
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/part"
      }
    }
  },
  "$defs": {
    "dimension": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "vector": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/dimension"
      }
    },
    "parameter": {
      "type": "object",
      "required": [
        "value",
        "unit",
        "status",
        "source_ids",
        "rationale"
      ],
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "specified",
            "measured",
            "inferred",
            "unknown"
          ]
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "expression": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "unknown"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "value": {
                "type": "number"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "measured"
              }
            }
          },
          "then": {
            "required": [
              "method"
            ]
          }
        }
      ]
    },
    "part": {
      "type": "object",
      "required": [
        "id",
        "label",
        "group",
        "evidence",
        "features"
      ],
      "properties": {
        "boolean_refine": {
          "type": "boolean",
          "default": true
        },
        "boolean_batch_runs": {
          "type": "integer",
          "minimum": 0
        },
        "geometry_instance_of": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "mesh_refine": {
          "type": "boolean",
          "default": false
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "group": {
          "type": "string"
        },
        "material": {
          "type": "string"
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "features": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/feature"
          }
        },
        "dressups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dressup"
          }
        },
        "placement": {
          "type": "object",
          "description": "Place an already valid local solid once; preserved as a linked native compound",
          "properties": {
            "origin": {
              "$ref": "#/$defs/vector"
            },
            "rotation_quaternion": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "number"
              },
              "description": "Explicit unit quaternion in x,y,z,w order"
            },
            "axis": {
              "$ref": "#/$defs/vector"
            },
            "roll": {
              "$ref": "#/$defs/dimension"
            },
            "mirror_normal": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number"
              }
            },
            "mirror_base": {
              "$ref": "#/$defs/vector"
            }
          }
        }
      }
    },
    "feature": {
      "type": "object",
      "required": [
        "primitive",
        "operation"
      ],
      "properties": {
        "primitive": {
          "enum": [
            "box",
            "cylinder",
            "cone",
            "sphere",
            "tube",
            "prism",
            "helix",
            "revolve",
            "loft",
            "polar_pattern"
          ]
        },
        "operation": {
          "enum": [
            "add",
            "cut"
          ]
        },
        "origin": {
          "$ref": "#/$defs/vector"
        },
        "axis": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number"
          }
        },
        "label": {
          "type": "string"
        },
        "length": {
          "$ref": "#/$defs/dimension"
        },
        "width": {
          "$ref": "#/$defs/dimension"
        },
        "height": {
          "$ref": "#/$defs/dimension"
        },
        "radius": {
          "$ref": "#/$defs/dimension"
        },
        "radius1": {
          "$ref": "#/$defs/dimension"
        },
        "radius2": {
          "$ref": "#/$defs/dimension"
        },
        "inner_radius": {
          "$ref": "#/$defs/dimension"
        },
        "wire_radius": {
          "$ref": "#/$defs/dimension"
        },
        "pitch": {
          "$ref": "#/$defs/dimension"
        },
        "sections": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "$ref": "#/$defs/dimension"
              }
            }
          }
        },
        "points": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "$ref": "#/$defs/dimension"
            }
          }
        },
        "left_handed": {
          "type": "boolean",
          "description": "Helix winding; false is right-handed"
        },
        "derived": {
          "type": "boolean",
          "description": "Use a calculated polygon profile instead of a constrained sketch"
        },
        "linked_profile": {
          "type": "boolean",
          "description": "Derived prism with expression-driven Part::Polygon and linked native Part::Extrusion"
        },
        "scale_parameter": {
          "type": "string",
          "description": "Positive parameter controlling a homogeneous derived sampled loft through a native uniform-scale link"
        },
        "profile_spline_runs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {"type": "integer", "minimum": 0}
          },
          "description": "Disjoint ordered inclusive section-point runs to interpolate; a new smooth approximation between retained samples, requiring geometry-specific checks"
        },
        "profile_parameterization": {
          "enum": ["chord_length", "uniform_levels"],
          "description": "Use common uniform level parameters across radial sections, or the curve constructor's chord-length default"
        },
        "count": {
          "type": "integer",
          "minimum": 2,
          "maximum": 360
        },
        "pattern_feature": {
          "$ref": "#/$defs/feature"
        },
        "tool_clip": {
          "$ref": "#/$defs/feature",
          "description": "Linked computational intersection before pattern copies; must preserve every tool/stock intersection"
        },
        "profile_curve_mode": {"enum": ["interpolate", "bezier_fit"]},
        "profile_curve_degree": {"type": "integer", "minimum": 3, "maximum": 5},
        "step_degrees": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 360,
          "description": "Fixed angular spacing for a partial polar pattern; default is 360/count"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "primitive": {
                "const": "loft"
              }
            }
          },
          "then": {
            "required": [
              "sections"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "primitive": {
                "const": "prism"
              }
            }
          },
          "then": {
            "required": [
              "points",
              "height"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "primitive": {
                "const": "revolve"
              }
            }
          },
          "then": {
            "required": [
              "points"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "primitive": {
                "const": "helix"
              }
            }
          },
          "then": {
            "required": [
              "radius",
              "wire_radius",
              "pitch",
              "height"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "primitive": {
                "const": "box"
              }
            }
          },
          "then": {
            "required": [
              "length",
              "width",
              "height"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "primitive": {
                "const": "cylinder"
              }
            }
          },
          "then": {
            "required": [
              "radius",
              "height"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "primitive": {
                "const": "cone"
              }
            }
          },
          "then": {
            "required": [
              "radius1",
              "radius2",
              "height"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "primitive": {
                "const": "sphere"
              }
            }
          },
          "then": {
            "required": [
              "radius"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "primitive": {
                "const": "tube"
              }
            }
          },
          "then": {
            "required": [
              "radius",
              "inner_radius",
              "height"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "primitive": {
                "const": "polar_pattern"
              }
            }
          },
          "then": {
            "required": [
              "count",
              "pattern_feature"
            ],
            "properties": {
              "pattern_feature": {
                "properties": {
                  "primitive": {
                    "enum": [
                      "box",
                      "cylinder",
                      "tube",
                      "cone",
                      "sphere",
                      "prism",
                      "revolve",
                      "loft"
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    },
    "dressup": {
      "type": "object",
      "required": [
        "type",
        "radius",
        "selectors"
      ],
      "properties": {
        "type": {
          "const": "fillet"
        },
        "radius": {
          "$ref": "#/$defs/dimension"
        },
        "label": {
          "type": "string"
        },
        "selectors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "curve",
              "center",
              "radius"
            ],
            "properties": {
              "curve": {
                "const": "circle"
              },
              "center": {
                "$ref": "#/$defs/vector"
              },
              "radius": {
                "$ref": "#/$defs/dimension"
              },
              "axis": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number"
                }
              },
              "arc_fraction": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1
              }
            }
          }
        }
      }
    }
  }
}
