  "motions": [
    {
      "id": "removal",
      "label": "Removal order (overhaul manual)",
      "scope": "The order is the GTSIO-520 overhaul manual's, Section VII (printed pages A-7-1 to A-7-5); the distances parts move are illustrative, and the engine-level steps are not in this one-cylinder model. Teaching sequence only: follow the current manual for the engine in front of you.",
      "duration_seconds": 20,
      "stages": [
        {
          "id": "assembled",
          "label": "Assembled",
          "progress": 0,
          "note": "One cylinder of the engine on its crankshaft throw. In the shop the engine is on a stand, its oil drained, and the ignition leads, magnetos, fuel injection, induction system and accessories come off before any cylinder (7-5 to 7-14)."
        },
        {
          "id": "nozzle",
          "label": "Fuel nozzle out",
          "progress": 11.11,
          "note": "The fuel injection system comes off before the cylinders, its nozzles kept in a clean container (7-7d)."
        },
        {
          "id": "covers",
          "label": "Rocker covers off",
          "progress": 22.22,
          "note": "With the engine inverted on the stand, the rocker covers and their gaskets come off (7-15a)."
        },
        {
          "id": "rockers",
          "label": "Rockers and pushrods out",
          "progress": 33.33,
          "note": "Turn the crankshaft until both valves of this cylinder are closed, its tappets on the heels of the cam lobes. Then the rocker shafts, rocker arms and thrust washers come off and the pushrods are withdrawn (7-15b)."
        },
        {
          "id": "housings",
          "label": "Pushrod housings out",
          "progress": 44.44,
          "note": "Each pushrod housing is pushed against its spring until the cylinder end is clear, then lifted out of the crankcase (7-15c)."
        },
        {
          "id": "cylinder",
          "label": "Cylinder off at top dead centre",
          "progress": 55.56,
          "note": "With the engine upright and this piston at top dead centre, the base nuts come off and the cylinder is drawn straight outward, the piston caught by hand as it clears (7-15d)."
        },
        {
          "id": "valves",
          "label": "Valve springs and valves out",
          "progress": 66.67,
          "note": "On a block at the bench, the springs are compressed and the keys removed, then the retainers or rotocap, the springs and the valves (7-15e, f). The manual recommends replacing every exhaust valve and rotocap at major overhaul."
        },
        {
          "id": "piston",
          "label": "Piston off",
          "progress": 77.78,
          "note": "The piston pin, piston and rings come off as an assembly, and the rings are taken off without scoring the ring lands (7-15g)."
        },
        {
          "id": "tappets",
          "label": "Hydraulic tappets out",
          "progress": 88.89,
          "note": "The hydraulic tappets come out; the manual recommends replacing them all at major overhaul (7-15h)."
        },
        {
          "id": "rod",
          "label": "Rod off the crankpin",
          "progress": 100,
          "note": "Only after the crankcase is split and the crankshaft lifted out (7-16, 7-18): the rod cap is unbolted, the bearing inserts removed, and rod, cap, bolt and nut loosely reassembled with their position numbers (7-18b)."
        }
      ],
